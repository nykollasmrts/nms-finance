{
  "name": "NMS Controle Financeiro",
  "short_name": "NMS",
  "description": "Controle financeiro pessoal e empresarial: lançamentos, agenda, contas a pagar e receber, DRE e indicadores.",
  "lang": "pt-BR",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["finance", "business", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Novo lançamento", "url": "./#lancamentos", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Contas a pagar e receber", "url": "./#agenda", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "DRE e indicadores", "url": "./#dashboard", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
